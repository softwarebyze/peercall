{
  "name": "peercall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:signal": "bun run signal/index.ts",
    "dev:all": "concurrently -k -n web,signal \"npm run dev\" \"npm run dev:signal\"",
    "build": "vite build",
    "generate:assets": "bun run scripts/generate-assets.mjs",
    "start": "vite preview",
    "prod": "bun run build && bun run server.ts",
    "deploy": "flyctl deploy --remote-builder",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "bun test src",
    "e2e": "playwright test",
    "demo": "bun run scripts/demo/repro.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.30",
    "html5-qrcode": "^2.3.8",
    "mediabunny": "^1.50.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "typescript": "^5.6.0",
    "vite": "^8.0.14",
    "vite-tsconfig-paths": "^5.1.0"
  }
}
