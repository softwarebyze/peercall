# PeerCall Configuration
# Copy this file to .env and fill in your values.

# Server port (production)
PORT=3000

# Comma-separated allowed origins (production)
# Leave empty to allow all origins.
# CORS_ORIGINS=https://peercall.example.com,https://www.peercall.example.com

# ── TURN (strongly recommended) ──────────────────────────────────────────────
# Without TURN, peers behind symmetric NATs / corporate firewalls often never
# appear in the video grid. Completely free options below.

# Option A — Free Metered Open Relay (sign up, then paste domain + API key):
#   https://www.metered.ca/tools/openrelay/
#METERED_DOMAIN=yourappname.metered.live
#METERED_TURN_API_KEY=your_api_key

# Option B — Your own TURN / coturn / other provider:
#TURN_URLS=turn:my-turn.example.com:3478
#TURN_USERNAME=my-user
#TURN_CREDENTIAL=my-secret
