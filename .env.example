# PeerCall Configuration
# Copy this file to .env and fill in your values.

# Server port (production)
PORT=3000

# Comma-separated allowed origins (production)
# Leave empty to allow all origins.
# CORS_ORIGINS=https://peercall.example.com,https://www.peercall.example.com

# TURN server configuration (optional).
# When unset, the app falls back to Open Relay's free TURN servers, so calls
# behind symmetric NATs / corporate firewalls still work at zero cost.
# Configure your own for better latency/reliability:
#   flyctl secrets set TURN_URLS=turn:... TURN_USERNAME=... TURN_CREDENTIAL=...
#TURN_URLS=turn:my-turn.example.com:3478
#TURN_USERNAME=my-user
#TURN_CREDENTIAL=my-secret
